# Copy to .env and fill in. Never commit .env.

# --- service ---
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=*

# --- database (Postgres, asyncpg driver) ---
DATABASE_URL=postgresql+asyncpg://backpac:backpac@localhost:5432/backpac

# --- LiveKit: the voice room the phone and agent share ---
# Free tier: https://livekit.io  ->  Project settings gives you all three.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- the agent runtime (BackPAC-Agent) ---
AGENT_BASE_URL=http://localhost:8080

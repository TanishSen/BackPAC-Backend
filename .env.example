# Copy to .env and fill in. Never commit .env.
# In production, set these as environment variables on the host instead.

# --- service ---
# "production" hides internal addresses from /readyz.
ENVIRONMENT=local
LOG_LEVEL=INFO
# The phone app ignores CORS. Only a Flutter *web* build needs its origin here.
CORS_ORIGINS=*
# Serve /docs and /openapi.json.
DOCS_ENABLED=true

# --- database: Supabase Postgres ---
# Project settings -> Database -> Connection string -> "Session pooler".
# Keep the +asyncpg driver prefix. Migrations are Postgres-only.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- identity: Supabase Auth ---
# The <ref> in https://<ref>.supabase.co. Tokens are verified against the
# project's public signing keys, so no Supabase secret goes here.
# Unset => every signed-in route returns 503.
SUPABASE_PROJECT_REF=
# Project settings -> API -> service_role key. Used ONLY to close a person's
# sign-in account when they delete their account in the app (both stores
# require it). Bypasses RLS: server env only, never the app. Unset => account
# deletion erases our data but leaves the sign-in account in place.
SUPABASE_SERVICE_ROLE_KEY=

# --- LiveKit: the voice room the phone and agent share ---
# These MUST match BackPAC-Agent/.env exactly.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- the agent runtime (BackPAC-Agent) ---
AGENT_BASE_URL=http://localhost:8080
# Shared secret, both directions: the agent sends it to log transcripts and
# search; this API sends it to start/stop bots. MUST equal the agent's
# BACKEND_SERVICE_TOKEN. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
SERVICE_TOKEN=

# --- flights: Travelpayouts / Aviasales (free affiliate API) ---
# Unset => clearly-labelled sample flights.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# --- Premium (RevenueCat) ---
# RevenueCat -> Integrations -> Webhooks: URL https://<api>/api/v1/billing/revenuecat,
# and set its Authorization header to this value.
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat -> API keys -> a v1 SECRET key. Lets the API ask RevenueCat
# directly after a purchase, and resolve transfers. Server only.
REVENUECAT_SECRET_KEY=
# The entitlement identifier in RevenueCat.
PREMIUM_ENTITLEMENT_ID=premium
# New trip plans a free account may start per month. 0 = no limit and no
# upgrade prompts anywhere. Only raise it once the store products are live.
FREE_MONTHLY_TRIP_PLANS=0

# --- abuse limits (defaults shown) ---
# SESSION_START_LIMIT=10
# SESSION_START_WINDOW_SECONDS=600
# SEARCH_LIMIT=30
# SEARCH_WINDOW_SECONDS=60
# VOICE_LIMIT=600
# VOICE_WINDOW_SECONDS=60

# --- behind a proxy ---
# Which proxies may set X-Forwarded-For. "*" is right behind a platform load
# balancer (Render, Railway, Fly, Cloud Run); narrow it if the app is exposed.
# FORWARDED_ALLOW_IPS=*

# Copy to .env and fill in. Never commit .env.

# --- service ---
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=*

# --- database ---
# SQLite needs no infrastructure — the API boots on a bare laptop with this.
# Point it at Postgres for anything shared; only the URL changes.
DATABASE_URL=sqlite+aiosqlite:///./backpac.db
# DATABASE_URL=postgresql+asyncpg://backpac:backpac@localhost:5432/backpac
#
# If the database is unreachable the API still starts: voice sessions and trip
# search use no tables. Only the saved-trip routes return 503. Check which is
# the case with GET /readyz -> "database_ready".

# --- LiveKit: the voice room the phone and agent share ---
# Free tier: https://livekit.io  ->  Project settings gives you all three.
# These MUST match BackPAC-Agent/.env exactly.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- the agent runtime (BackPAC-Agent) ---
AGENT_BASE_URL=http://localhost:8080
